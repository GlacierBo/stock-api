{
  "name": "stock-api",
  "version": "2.3.0",
  "private": true,
  "description": "Stock market data web application",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm -w server run dev",
    "dev:client": "npm -w client run dev",
    "build": "npm -w client run build && npm -w server run build",
    "start": "npm -w server run start",
    "typecheck": "npm -w server run typecheck && npm -w client run typecheck",
    "lint": "eslint ."
  },
  "workspaces": [
    "server",
    "client"
  ],
  "devDependencies": {
    "concurrently": "^9.1.2",
    "@eslint/js": "^10.0.1",
    "globals": "^17.5.0",
    "eslint": "^10.2.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1"
  }
}
